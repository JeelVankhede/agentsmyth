#!/bin/sh
# agentsmyth dev pre-commit gate.
# Runs the read-only contract validators before every commit so drift between
# source (src/) and the shipped contract is caught at commit time, not in CI.
#
# Enable with:  npm run hooks:install
# Bypass once:  git commit --no-verify   (use only when you know why)

set -e

# Only gate commits that touch workflow source, setup, adapters, scripts, or examples.
CHANGED=$(git diff --cached --name-only --diff-filter=ACM)
if ! printf '%s\n' "$CHANGED" | grep -qE '^(src/|scripts/|examples/)'; then
  exit 0
fi

echo "agentsmyth pre-commit: validating workflow contract..."
node scripts/validate-template.mjs
node scripts/validate-example.mjs

echo "agentsmyth pre-commit: reminder — if you changed src/workflow/, src/setup/, or src/adapters/,"
echo "run 'npm run build' so dist/ and generated assets stay in sync before pushing."
# >>> agentsmyth:mandatory-lifecycle-gate >>>
# Installed by `agentsmyth init` — mandatory, local-only lifecycle gate. Two checks:
# 1. Coverage: staged, non-safe files must be covered by a real lifecycle task artifact
#    (agentsmyth check --staged / check-commit-coverage.mjs) — a fast, narrow proxy.
# 2. Phase-gate readiness: any staged lifecycle artifact file (workflow/artifacts/<dir>/<slug>-vN.md)
#    must have its entering phase's gate actually satisfied (agentsmyth check --phase/--slug),
#    e.g. committing a Plan without its own Checkpoint Approval recorded is rejected.
# Bypass deliberately, when you mean to: git commit --no-verify
if command -v agentsmyth >/dev/null 2>&1; then
  AGENTSMYTH_BIN="agentsmyth"
else
  AGENTSMYTH_BIN="npx --yes @jeelvankhede/agentsmyth"
fi

$AGENTSMYTH_BIN check --staged
status=$?

STAGED=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)
ARTIFACT_FILES=$(printf '%s\n' "$STAGED" | grep -E '^workflow/artifacts/[^/]+/.+-v[0-9]+\.md$' || true)

if [ -n "$ARTIFACT_FILES" ]; then
  phase_for_dir() {
    case "$1" in
      briefs)   echo "plan"    ;;
      plans)    echo "build"   ;;
      tasks)    echo "review"  ;;
      reviews)  echo "test"    ;;
      verify)   echo "ship"    ;;
      ship)     echo "reflect" ;;
      *)        echo ""       ;;  # reflect (no downstream gate) and anything unrecognized
    esac
  }

  IFS='
'
  for file in $ARTIFACT_FILES; do
    dir=$(printf '%s' "$file" | cut -d/ -f3)
    base=$(basename "$file" .md)
    slug=$(printf '%s' "$base" | sed 's/-v[0-9][0-9]*$//')
    phase=$(phase_for_dir "$dir")
    [ -z "$phase" ] && continue

    # OI-74, generalized: an artifact is legitimately in progress for the whole of the phase that
    # owns it — a task for the whole of Build, a brief for the whole of Think — and its schema
    # expects it to be committed repeatedly while that phase runs. Gating every staged artifact on
    # its DOWNSTREAM phase made those incremental commits impossible, leaving only one giant
    # end-of-phase commit or routine --no-verify. Routine bypass of a mandatory gate trains exactly
    # the habit the gate exists to prevent.
    # So: check the downstream gate only once the artifact claims to be ready for it — for every
    # artifact directory, not for tasks alone. The tasks-only scoping fixed the instance hit first
    # and left the same wall one directory over: an in-progress brief could not be committed at all.
    # Read the STAGED blob, not the working tree. Everything else in this hook reasons about the
    # index, and a commit is of the index — reading the file on disk would let an unstaged edit
    # decide whether a staged artifact is gated, in either direction.
    #
    # Match orchestration.status (indented), which is the field check-lifecycle actually reads, and
    # fall back to the top-level status only if the block is absent.
    staged_blob=$(git show ":$file" 2>/dev/null || true)
    orch_status=$(printf '%s\n' "$staged_blob" | awk '/^orchestration:/{o=1;next} o&&/^[^[:space:]]/{o=0} o&&/^[[:space:]]+status:/{print $2;exit}')
    [ -z "$orch_status" ] && orch_status=$(printf '%s\n' "$staged_blob" | awk '/^status:/{print $2;exit}')
    # Skip ONLY on a status we positively read that is not ready. An unreadable blob, or a file
    # whose status cannot be parsed, leaves this empty — and empty must gate rather than skip,
    # since "I could not tell" is not "it is fine".
    if [ -n "$orch_status" ] && [ "$orch_status" != "ready-for-next-phase" ]; then
      continue
    fi
    if ! $AGENTSMYTH_BIN check --phase "$phase" --slug "$slug"; then
      status=1
    fi
  done
fi

if [ "$status" -ne 0 ]; then
  exit "$status"
fi
# <<< agentsmyth:mandatory-lifecycle-gate <<<
